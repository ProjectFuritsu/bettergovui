{
  "name": "bettergovregiondavaoui",
  "version": "0.1.0",
  "description": "Accessible React components and page blocks for Philippine government websites, in English, Filipino and Bisaya.",
  "keywords": [
    "react",
    "ui",
    "components",
    "design-system",
    "accessibility",
    "a11y",
    "government",
    "philippines",
    "filipino",
    "bisaya",
    "psgc",
    "davao"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ProjectFuritsu/bettergovui.git"
  },
  "homepage": "https://github.com/ProjectFuritsu/bettergovui#readme",
  "bugs": {
    "url": "https://github.com/ProjectFuritsu/bettergovui/issues"
  },
  "license": "CC0-1.0",
  "author": "ProjectFuritsu",
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./styles.css": {
      "types": "./types/styles.css.d.ts",
      "default": "./dist/index.css"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "types"
  ],
  "scripts": {
    "dev": "vite playground",
    "build": "tsup",
    "typecheck": "tsc --noEmit && tsc -p playground --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.2"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "allowScripts": {
    "esbuild@0.27.2": true
  }
}
